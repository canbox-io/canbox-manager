{
    "name": "canbox-manager",
    "version": "0.1.0",
    "description": "Canbox 管理器 APP — APP 注册管理、仓库管理、系统设置",
    "main": "main.js",
    "license": "Apache-2.0",
    "author": "lizl6",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5101",
        "build": "vite build",
        "start": "NODE_ENV=development electron -r /depot/cargo/canbox-core/injection.js . --app-id=canbox-manager --no-sandbox",
        "dist": "vite build && electron-builder",
        "dist:linux": "vite build && electron-builder --linux",
        "dist:win": "vite build && electron-builder --win",
        "dist:mac": "vite build && electron-builder --mac"
    },
    "dependencies": {
        "adm-zip": "^0.5.16",
        "axios": "^1.18.1",
        "element-plus": "^2.8.3",
        "markdown-it": "^14.3.0",
        "pinia": "^3.0.3",
        "vue": "^3.4.21",
        "vue-i18n": "^11.2.8",
        "vue-router": "^4.4.5"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.1.2",
        "electron": "^41.2.1",
        "electron-builder": "^25.0.0",
        "vite": "^5.4.6"
    },
    "build": {
        "appId": "com.canbox.manager",
        "productName": "Canbox",
        "directories": {
            "output": "release"
        },
        "artifactName": "Canbox-${os}-${arch}.${ext}",
        "files": [
            "main.js",
            "preload.js",
            "repo-probe.js",
            "app-launcher.js",
            "build/**",
            "icons/**",
            "logo.png",
            "logo.svg",
            "!**/.canbox-*"
        ],
        "extraResources": [
            {
                "from": "../canbox-core",
                "to": "canbox-core",
                "filter": [
                    "**",
                    "!**/.git/**",
                    "!**/.canbox-*",
                    "!**/docs/**",
                    "!**/*.md",
                    "!**/package-lock.json"
                ]
            }
        ],
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Utility",
            "icon": "icons/512.png"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "icons/512.png"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.utilities",
            "icon": "icons/512.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
