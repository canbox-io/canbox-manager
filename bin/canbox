#!/bin/bash
# Canbox 启动器
# 用法: canbox manager | canbox app <appId>
#
# 由安装脚本生成 desktop/lnk 快捷方式时调用，也可手动执行。
# CANBOX_HOME 通过脚本位置自动推导，支持安装到任意路径。

set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CANBOX_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

CORE="$CANBOX_HOME/canbox-core/injection.js"

if [ ! -f "$CORE" ]; then
    echo "[canbox] 错误: 找不到 canbox-core: $CORE" >&2
    exit 1
fi

export CANBOX_ENV=production
export NODE_ENV=production

USER_DATA="${CANBOX_USER_DATA:-${CANBOX_HOME_ENV:-$HOME/.config/canbox}}"

USERS_PATH=""
PATHS_JSON="$USER_DATA/paths.json"
if [ -f "$PATHS_JSON" ]; then
    USERS_PATH=$(grep -o '"usersPath"[[:space:]]*:[[:space:]]*"[^"]*"' "$PATHS_JSON" | head -1 | sed 's/.*: *"//;s/".*$//')
fi
if [ -z "$USERS_PATH" ]; then
    USERS_PATH="$USER_DATA/Users"
fi

findBuiltinElectron() {
    local dir
    for dir in "$CANBOX_HOME"/electron-*/; do
        if [ -f "$dir/electron" ]; then
            echo "${dir}electron"
            return 0
        fi
    done
    return 1
}

# ====== 纯 bash 实现 electron-selector 核心逻辑 ======

# 白名单版本
declare -A ALLOWED_VERSIONS=(
    ['42.5.1']=1
)

# 解析版本号
parseVersion() {
    local ver="$1"
    IFS='.' read -r major minor patch <<< "$ver"
    printf "%03d.%03d.%03d" "${major:-0}" "${minor:-0}" "${patch:-0}"
}

# 比较版本: a > b 返回 1, a < b 返回 -1, 相等返回 0
compareVersions() {
    local a_normalized=$(parseVersion "$1")
    local b_normalized=$(parseVersion "$2")
    if [ "$a_normalized" \> "$b_normalized" ]; then
        echo 1
    elif [ "$a_normalized" \< "$b_normalized" ]; then
        echo -1
    else
        echo 0
    fi
}

# 检查版本是否满足 range（支持 ^x.y.z 和精确匹配）
satisfies() {
    local version="$1"
    local range="$2"
    range=$(echo "$range" | tr -d '[:space:]')

    if [ -z "$range" ] || [ "$range" = "*" ]; then
        return 0
    fi

    if [[ "$range" == ^* ]]; then
        local target="${range:1}"
        IFS='.' read -r tmajor tminor tpatch <<< "$target"
        IFS='.' read -r vmajor vminor vpatch <<< "$version"

        if [ "$vmajor" != "$tmajor" ]; then
            return 1
        fi
        local cmp=$(compareVersions "$version" "$target")
        [ "$cmp" -ge 0 ]
        return $?
    fi

    local cmp=$(compareVersions "$version" "$range")
    [ "$cmp" -eq 0 ]
    return $?
}

# 获取 .canbox-app 中的 electron.range
getElectronRange() {
    local app_dir="$1"
    local meta_file="$app_dir/.canbox-app"
    if [ ! -f "$meta_file" ]; then
        echo ""
        return
    fi
    local range=$(grep -o '"range"[[:space:]]*:[[:space:]]*"[^"]*"' "$meta_file" | head -1 | sed 's/.*: *"//;s/".*$//')
    echo "$range"
}

# 扫描 builtin electron 版本
scanBuiltinVersions() {
    local electronBinaryName="electron"
    if [ "$(uname -s)" = "Darwin" ]; then
        electronBinaryName="Electron.app/Contents/MacOS/Electron"
    elif [ "$(uname -s)" = "Windows_NT" ]; then
        electronBinaryName="electron.exe"
    fi

    local results=""
    for dir in "$CANBOX_HOME"/electron-*/; do
        if [ -d "$dir" ] && [ -f "$dir/$electronBinaryName" ]; then
            local ver="${dir%/}"
            ver="${ver##*/}"
            ver="${ver##electron-}"
            results="$results $ver"
        fi
    done
    echo "$results"
}

# 读取 downloaded 版本注册表
readDownloadedVersions() {
    local registryPath="$USER_DATA/runtime/electron-registry.json"
    if [ ! -f "$registryPath" ]; then
        echo ""
        return
    fi
    local versions=$(grep -o '"electron"[[:space:]]*:[[:space:]]*"[^"]*"' "$registryPath" | sed 's/.*: *"//;s/".*$//')
    echo "$versions"
}

# 解析下载注册表获取版本路径
getDownloadedVersionPath() {
    local ver="$1"
    local registryPath="$USER_DATA/runtime/electron-registry.json"
    if [ ! -f "$registryPath" ]; then
        echo ""
        return
    fi
    local path=$(grep -A 5 "\"electron\": \"$ver\"" "$registryPath" | grep -o '"path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*: *"//;s/".*$//')
    if [ -z "$path" ]; then
        echo ""
        return
    fi
    local electronBinaryName="electron"
    if [ "$(uname -s)" = "Darwin" ]; then
        electronBinaryName="Electron.app/Contents/MacOS/Electron"
    elif [ "$(uname -s)" = "Windows_NT" ]; then
        electronBinaryName="electron.exe"
    fi
    local fullPath="$USER_DATA/runtime/$path/$electronBinaryName"
    if [ -f "$fullPath" ]; then
        echo "$fullPath"
    else
        echo ""
    fi
}

# 通过 bash 实现的 selector 选择 APP 的 electron 版本
resolveAppElectron() {
    local app_dir="$1"

    local range=$(getElectronRange "$app_dir")
    if [ -z "$range" ]; then
        echo "[canbox] 错误: APP 未声明 electron 版本（.canbox-app 中 electron.range 缺失）" >&2
        exit 1
    fi

    local allowed_candidates=""
    for ver in "${!ALLOWED_VERSIONS[@]}"; do
        if satisfies "$ver" "$range"; then
            allowed_candidates="$allowed_candidates $ver"
        fi
    done

    if [ -z "$allowed_candidates" ]; then
        echo "[canbox] 错误: canbox 未纳入满足 $range 的 electron 版本" >&2
        exit 1
    fi

    local builtin_versions=$(scanBuiltinVersions)
    local downloaded_versions=$(readDownloadedVersions)

    local all_candidates="$builtin_versions $downloaded_versions"

    local valid_candidates=""
    for ver in $all_candidates; do
        for allowed in $allowed_candidates; do
            if [ "$ver" = "$allowed" ]; then
                valid_candidates="$valid_candidates $ver"
                break
            fi
        done
    done

    if [ -z "$valid_candidates" ]; then
        local highest_allowed=""
        for ver in $allowed_candidates; do
            if [ -z "$highest_allowed" ] || [ "$(compareVersions "$ver" "$highest_allowed")" -gt 0 ]; then
                highest_allowed="$ver"
            fi
        done
        echo "[canbox] 需要下载 electron: $highest_allowed" >&2
        exit 1
    fi

    local selected_version=""
    for ver in $valid_candidates; do
        if [ -z "$selected_version" ] || [ "$(compareVersions "$ver" "$selected_version")" -gt 0 ]; then
            selected_version="$ver"
        fi
    done

    local electronPath=""
    local found_in_builtin=0
    for ver in $builtin_versions; do
        if [ "$ver" = "$selected_version" ]; then
            found_in_builtin=1
            break
        fi
    done

    if [ "$found_in_builtin" -eq 1 ]; then
        local electronBinaryName="electron"
        if [ "$(uname -s)" = "Darwin" ]; then
            electronBinaryName="Electron.app/Contents/MacOS/Electron"
        elif [ "$(uname -s)" = "Windows_NT" ]; then
            electronBinaryName="electron.exe"
        fi
        electronPath="$CANBOX_HOME/electron-$selected_version/$electronBinaryName"
    else
        electronPath=$(getDownloadedVersionPath "$selected_version")
    fi

    if [ -z "$electronPath" ] || [ ! -f "$electronPath" ]; then
        echo "[canbox] 错误: 找不到 electron 二进制文件: $selected_version" >&2
        exit 1
    fi

    echo "$electronPath"
}

case "${1:-}" in
    manager)
        ELECTRON=$(findBuiltinElectron) || {
            echo "[canbox] 错误: 找不到 builtin electron（$CANBOX_HOME/electron-*/electron）" >&2
            exit 1
        }
        exec "$ELECTRON" -r "$CORE" "$CANBOX_HOME/manager/" --app-id=canbox-manager --no-sandbox
        ;;
    app)
        APP_ID="$2"
        if [ -z "$APP_ID" ]; then
            echo "用法: canbox app <appId>" >&2
            exit 1
        fi
        APP_DIR="$USERS_PATH/apps/$APP_ID"
        if [ -f "$APP_DIR/app.asar" ]; then
            APP_TARGET="$APP_DIR/app.asar"
        elif [ -d "$APP_DIR" ]; then
            APP_TARGET="$APP_DIR/"
        else
            echo "[canbox] 错误: APP 不存在: $APP_ID (路径: $APP_DIR)" >&2
            exit 1
        fi

        ELECTRON=$(resolveAppElectron "$APP_DIR")

        IS_WEB_APP=0
        CANBOX_APP_FILE="$APP_DIR/.canbox-app"
        if [ -f "$CANBOX_APP_FILE" ]; then
            if grep -q '"type"[[:space:]]*:[[:space:]]*"web"' "$CANBOX_APP_FILE" 2>/dev/null; then
                IS_WEB_APP=1
            fi
        fi

        if [ "$IS_WEB_APP" = "1" ]; then
            exec "$ELECTRON" "$APP_TARGET" --no-sandbox
        else
            exec "$ELECTRON" -r "$CORE" "$APP_TARGET" "--app-id=$APP_ID" --no-sandbox
        fi
        ;;
    *)
        echo "Canbox 启动器" >&2
        echo "用法: canbox manager | canbox app <appId>" >&2
        exit 1
        ;;
esac